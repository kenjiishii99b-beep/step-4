# docker-compose 用のルート環境変数。
# `cp .env.example .env` してから `docker compose up` すること。

# --- MySQL ---
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=apparel_pos
MYSQL_USER=apparel_pos
MYSQL_PASSWORD=apparel_pos_password
MYSQL_PORT=3306

# --- Backend (FastAPI) ---
BACKEND_PORT=8000
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# --- Frontend (Next.js) ---
FRONTEND_PORT=3000
# BACKEND_INTERNAL_URL は docker-compose.yml 側で backend:8000 に固定しているため、
# ここでの設定は不要（Docker を使わないローカル起動時のみ frontend/.env.local を参照）。
