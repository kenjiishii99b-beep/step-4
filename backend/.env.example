# `cp .env.example .env` して値を調整すること。
# Docker Compose 経由で起動する場合はリポジトリルートの .env が優先される。

DATABASE_URL=mysql+asyncmy://apparel_pos:apparel_pos_password@localhost:3306/apparel_pos
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
ENVIRONMENT=local
